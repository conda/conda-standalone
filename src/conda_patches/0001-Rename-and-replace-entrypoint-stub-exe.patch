From 936a565f39da5673eef8d7fff8394467ba9f47be Mon Sep 17 00:00:00 2001
From: Nehal J Wani <nehaljw.kkd1@gmail.com>
Date: Tue, 13 Aug 2019 07:43:35 -0400
Subject: [PATCH 1/4] Rename and replace entrypoint stub exe

Updated for conda 26.9.0 which extracted the launcher lookup into
conda/core/launchers.py and now verifies a SHA-256 for the stub.

---
 conda/core/launchers.py | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/conda/core/launchers.py b/conda/core/launchers.py
--- a/conda/core/launchers.py
+++ b/conda/core/launchers.py
@@ -4,6 +4,8 @@
 
 from __future__ import annotations
 
+import sys
+
 from os.path import isfile, join, normpath
 from typing import TYPE_CHECKING
 
@@ -30,6 +32,12 @@
     source_package_infos: Iterable[PackageInfo] = (),
 ) -> tuple[str, str]:
     """Return the target Python's launcher path and expected SHA-256."""
+    # conda-standalone bundles its own entry point stub as entry_point_base.exe
+    # in sys.prefix. Prefer it over the one shipped by the conda package.
+    standalone_stub = join(sys.prefix, "entry_point_base.exe")
+    if isfile(standalone_stub):
+        return standalone_stub, compute_sum(standalone_stub, "sha256")
+
     source_package_infos = tuple(source_package_infos)
     python_record = next(
         (
